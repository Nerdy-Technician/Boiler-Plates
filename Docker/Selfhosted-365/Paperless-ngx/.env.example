# Paperless-ngx
PAPERLESS_TAG=latest
PAPERLESS_NAME=paperless
PAPERLESS_PORT_HOST=8010
PAPERLESS_TIME_ZONE=Europe/London
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_URL=https://paperless.example.com
PAPERLESS_SECRET_KEY=change-me-generate-a-long-random-string

# Paths
PAPERLESS_DATA_PATH=./data
PAPERLESS_MEDIA_PATH=./media
PAPERLESS_EXPORT_PATH=./export
PAPERLESS_CONSUME_PATH=./consume

# Database
POSTGRES_TAG=16-alpine
POSTGRES_NAME=paperless-postgres
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=paperless
POSTGRES_DATA_PATH=./postgres

# Redis
REDIS_TAG=7-alpine
REDIS_NAME=paperless-redis

# Optional document processors
GOTENBERG_TAG=latest
TIKA_TAG=latest

NETWORK_NAME=paperless-net
